# Copy to backend.env and supply credentials for a dedicated test GitHub App.
HTTP_BASIC_AUTH_USERNAME=local-profile
HTTP_BASIC_AUTH_PASSWORD=REPLACE_ME
BEARER_AUTH_TOKEN=REPLACE_ME
GITHUB_APP_PRIVATE_KEY_BASE64=REPLACE_ME
GITHUB_APP_CLIENT_ID=REPLACE_ME
GITHUB_APP_CLIENT_SECRET=REPLACE_ME
GITHUB_WEBHOOK_SECRET=REPLACE_ME
